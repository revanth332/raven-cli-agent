ConnectModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#preset_modal_container {
    width: 82;
    max-width: 90;
    height: 22;
    background: #18181a;
    border: none;
    padding: 1 2;
}

#preset_header_row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#preset_modal_title {
    width: 1fr;
    color: #FFFFFF;
    text-style: bold;
}

#preset_close_hint {
    width: auto;
    color: #71717a;
    text-align: right;
}

#preset_search_input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    padding: 0;
    margin-bottom: 1;
    color: #F8FAFC;
}

#preset_option_list {
    height: 1fr;
    background: transparent;
    border: none;
    scrollbar-gutter: stable;
    scrollbar-size: 0 0;
}

#preset_option_list > .option-list--option {
    padding: 0 1;
    background: transparent;
    border: none;
    color: #F8FAFC;
}

#preset_option_list > .option-list--option-highlighted {
    background: #10B981;
    color: #062b1e;
    text-style: bold;
    border: none;
}

#preset_option_list > .option-list--option.-disabled {
    background: transparent;
    color: #10B981;
    border: none;
    padding: 0 1;
    text-style: bold;
}

#preset_footer_shortcuts {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #E2E8F0;
}

PresetFormModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#preset_form_container {
    width: 76;
    height: auto;
    max-height: 90%;
    overflow-y: auto;
    background: #18181a;
    border: none;
    padding: 1 2;
}

#preset_form_header_row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#preset_form_title {
    width: 1fr;
    color: #FFFFFF;
    text-style: bold;
}

#preset_form_close_hint {
    width: auto;
    color: #71717a;
    text-align: right;
}

PresetFormModal .field_label {
    color: #94A3B8;
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
}

PresetFormModal .field_input {
    margin-bottom: 1;
    background: #252526;
    border: none;
    color: #F8FAFC;
}

PresetFormModal .field_input:focus {
    border: none;
}

PresetFormModal .field_input:disabled {
    opacity: 0.55;
    background: #1e1e1e;
    color: #64748B;
}

PresetFormModal #provider_type_radios {
    height: auto;
    background: transparent;
    border: none;
    margin-bottom: 1;
    layout: horizontal;
}

PresetFormModal #provider_type_radios > RadioButton {
    background: transparent;
    padding: 0 1;
    margin-right: 2;
    color: #E2E8F0;
}

PresetFormModal #provider_type_radios:disabled > RadioButton {
    opacity: 0.55;
    color: #64748B;
}

PresetFormModal #form_error_label {
    color: #EF4444;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 1;
    display: none;
}

PresetFormModal #form_button_container {
    height: auto;
    align: right middle;
    margin-top: 1;
}

PresetFormModal Button {
    margin-left: 1;
    min-width: 10;
    height: 3;
    padding: 0 1;
    border: none;
}

PresetFormModal #cancel_btn {
    background: transparent;
    color: #E2E8F0;
    border: none;
}

PresetFormModal #cancel_btn:hover {
    background: #27272a;
}

PresetFormModal #submit_btn {
    background: #10B981;
    color: #062b1e;
    border: none;
    min-width: 16;
    text-style: bold;
}

PresetFormModal #submit_btn:hover {
    background: #059669;
}

