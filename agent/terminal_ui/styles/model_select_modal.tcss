ModelSelectModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

ModelSelectModal #model_modal_container {
    width: 80;
    max-width: 90;
    height: 24;
    background: #18181a;
    border: none;
    padding: 1 2;
}

ModelSelectModal #model_header_row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

ModelSelectModal #model_modal_title {
    width: 1fr;
    color: #FFFFFF;
    text-style: bold;
}

ModelSelectModal #model_close_hint {
    width: auto;
    color: #71717a;
    text-align: right;
}

ModelSelectModal #search_input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    padding: 0;
    margin-bottom: 1;
    color: #F8FAFC;
}

ModelSelectModal #search_input:focus {
    border: none;
}

ModelSelectModal #model_list {
    height: 1fr;
    background: transparent;
    border: none;
    scrollbar-gutter: stable;
    scrollbar-size: 0 0;
}

ModelSelectModal #model_list > .option-list--option {
    padding: 0 1;
    background: transparent;
    border: none;
    color: #F8FAFC;
}

ModelSelectModal #model_list > .option-list--option-highlighted {
    background: #10B981;
    color: #062b1e;
    text-style: bold;
    border: none;
}

ModelSelectModal #model_list > .option-list--option.-disabled {
    background: transparent;
    color: #a29bfe;
    border: none;
    padding: 0 1;
    text-style: none;
}

ModelSelectModal #custom_input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    padding: 0;
    margin-top: 1;
    margin-bottom: 0;
    color: #F8FAFC;
}

ModelSelectModal #custom_input:focus {
    border: none;
}

ModelSelectModal #status_label {
    width: 100%;
    color: #71717a;
    height: 1;
    margin-top: 1;
    text-align: left;
}

ModelSelectModal #model_footer_shortcuts {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #E2E8F0;
}
