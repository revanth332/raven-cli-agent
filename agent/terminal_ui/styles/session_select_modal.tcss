SessionSelectModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#session_modal_container {
    width: 80;
    max-width: 90;
    height: 22;
    background: #18181a;
    border: none;
    padding: 1 2;
}

#session_header_row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#session_modal_title {
    width: 1fr;
    color: #FFFFFF;
    text-style: bold;
}

#session_close_hint {
    width: auto;
    color: #71717a;
    text-align: right;
}

#session_search_input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    padding: 0;
    margin-bottom: 1;
    color: #F8FAFC;
}

#session_option_list {
    height: 1fr;
    background: transparent;
    border: none;
    scrollbar-gutter: stable;
    scrollbar-size: 0 0;
}

#session_option_list > .option-list--option {
    padding: 0 1;
    background: transparent;
    border: none;
    color: #F8FAFC;
}

#session_option_list > .option-list--option-highlighted {
    background: #10B981;
    color: #062b1e;
    text-style: bold;
    border: none;
}

#session_option_list > .option-list--option.-disabled {
    background: transparent;
    color: #10B981;
    border: none;
    padding: 0 1;
    text-style: bold;
}

#session_footer_shortcuts {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #E2E8F0;
}

