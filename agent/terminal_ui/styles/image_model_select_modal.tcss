ImageModelSelectModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

ImageModelSelectModal #image_modal_container {
    width: 82;
    max-width: 92;
    height: 26;
    background: #18181a;
    border: none;
    padding: 1 2;
}

ImageModelSelectModal #image_header_row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

ImageModelSelectModal #image_modal_title {
    width: 1fr;
    color: #FFFFFF;
    text-style: bold;
}

ImageModelSelectModal #image_close_hint {
    width: auto;
    color: #71717a;
    text-align: right;
}

ImageModelSelectModal #search_input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    padding: 0;
    margin-bottom: 1;
    color: #F8FAFC;
}

ImageModelSelectModal #search_input:focus {
    border: none;
}

ImageModelSelectModal #image_model_list {
    height: 1fr;
    background: transparent;
    border: none;
    scrollbar-gutter: stable;
    scrollbar-size: 0 0;
}

ImageModelSelectModal #image_model_list > .option-list--option {
    padding: 0 1;
    background: transparent;
    border: none;
    color: #F8FAFC;
}

ImageModelSelectModal #image_model_list > .option-list--option-highlighted {
    background: #10B981;
    color: #062b1e;
    text-style: bold;
    border: none;
}

ImageModelSelectModal #custom_input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    padding: 0;
    margin-top: 1;
    margin-bottom: 0;
    color: #F8FAFC;
}

ImageModelSelectModal #custom_input:focus {
    border: none;
}

ImageModelSelectModal #status_label {
    width: 100%;
    color: #71717a;
    height: 1;
    margin-top: 1;
    text-align: left;
}

ImageModelSelectModal #image_footer_shortcuts {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #E2E8F0;
}
