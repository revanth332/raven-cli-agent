CreateSkillModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

#create_skill_container {
    width: 80%;
    max-width: 90;
    height: 85%;
    background: #1e1e1e;
    border: none;
    padding: 1 2;
}

#create_skill_title {
    text-align: center;
    margin-bottom: 1;
    color: #06B6D4;
    text-style: bold;
}

.form_label {
    color: #38BDF8;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

#input_skill_name {
    background: #252526;
    border: none;
    color: #F8FAFC;
    margin-bottom: 1;
    height: 3;
}

#input_skill_desc {
    background: #252526;
    border: none;
    color: #F8FAFC;
    height: 5;
    margin-bottom: 1;
}

#input_skill_content {
    background: #252526;
    border: none;
    color: #F8FAFC;
    height: 1fr;
    min-height: 8;
    margin-bottom: 1;
}

#create_skill_actions {
    height: auto;
    align: right middle;
}

Button {
    margin-left: 1;
    min-width: 14;
    height: 3;
    padding: 0 1;
}

#btn_cancel_create {
    background: transparent;
    color: #E2E8F0;
    border: round #64748B;
}

#btn_submit_create {
    background: transparent;
    color: #E2E8F0;
    border: round #64748B;
}

#btn_submit_create:hover {
    background: #2d3748;
    color: #38BDF8;
}

SkillsManagerModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#skills_modal_container {
    width: 75%;
    max-width: 85;
    height: 70%;
    background: #1e1e1e;
    border: none;
    padding: 1 2;
}

#skills_modal_title {
    text-align: center;
    margin-bottom: 1;
    color: #06B6D4;
    text-style: bold;
}

#skills_search_input {
    margin-bottom: 1;
    background: #252526;
    border: solid #06B6D4;
}

#skills_option_list {
    height: 1fr;
    background: #121212;
    border: none;
    margin-bottom: 1;
}

#skills_option_list > .option-list--option {
    padding: 1 2;
}

#skills_option_list > .option-list--option-highlighted {
    background: #2d3748;
}

#skills_modal_actions {
    height: auto;
    align: right middle;
}

#btn_close_skills {
    background: transparent;
    color: #E2E8F0;
    border: round #64748B;
}

#btn_create_skill {
    background: transparent;
    color: #E2E8F0;
    border: round #64748B;
}

#btn_create_skill:hover {
    background: #2d3748;
    color: #38BDF8;
}
